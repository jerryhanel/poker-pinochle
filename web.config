<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <security>
      <requestFiltering>
        <!-- Allow static assets (css/js/fonts); block source docs from the web. -->
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".md" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
        </fileExtensions>

        <!-- Server-side-only folders: never reachable over HTTP. -->
        <hiddenSegments>
          <add segment="lib" />
          <add segment="engine" />
          <add segment="migrations" />
        </hiddenSegments>

        <!-- Belt-and-braces: never serve the config files. -->
        <denyUrlSequences>
          <add sequence="config.php" />
          <add sequence="config.sample.php" />
        </denyUrlSequences>
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
